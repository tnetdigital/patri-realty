{
  "name": "patri-realty",
  "version": "1.0.0",
  "description": "Portal Patri Realty — guia de fornecedores para condomínios",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --local --schema public > src/lib/database.types.ts",
    "local:up": "bash scripts/local-up.sh",
    "local:test:db": "bash scripts/local-test-db.sh",
    "local:test:e2e": "PATRI_LIVE_TESTS=1 playwright test",
    "format": "prettier --write src tests *.ts *.js index.html scripts/*.mjs",
    "format:check": "prettier --check src tests *.ts *.js index.html scripts/*.mjs",
    "build:ssr": "npm run build && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "start": "node server.mjs",
    "test:ssr": "node scripts/test-public-ssr.mjs",
    "test:http": "node --test tests/*-http.test.mjs tests/corrections-*.test.mjs",
    "local:quotations": "node scripts/local-quotations.mjs",
    "launch:check": "node scripts/launch-readiness.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.edge.json",
    "lint": "eslint src scripts server.mjs server backend preview-host supabase/functions tests --quiet",
    "check:env": "node scripts/check-env.mjs",
    "check:architecture": "node --test tests/corrections-access.test.mjs",
    "local:init": "node scripts/local-init.mjs",
    "check:private-editorial": "node scripts/check-private-editorial.mjs",
    "preview:protected": "node scripts/prepare-protected-preview.mjs",
    "test:preview-security": "node --test tests/preview-access-http.test.mjs && node scripts/test-preview-server.mjs",
    "test:seo": "node scripts/test-seo-contract.mjs",
    "test:eligibility": "node scripts/test-local-eligibility.mjs",
    "review:local": "node scripts/review-local-document.mjs",
    "test:structured": "node scripts/test-structured.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "^10.13.0",
    "lighthouse": "^13.5.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "6.4.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "private": true
}
