STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
SITE_URL=
EMAIL_FROM=

SUPPLIER_JOBS_SECRET=

QUOTATION_IP_SALT=
VITE_QUOTATION_URL=
VITE_SITE_URL=

EVENT_IP_SALT=
ACCOUNT_IP_SALT=
VITE_EVENT_URL=
VITE_ACCOUNT_URL=
VITE_NEWSLETTER_URL=
VITE_BANNER_EVENT_URL=
VITE_LOGIN_URL=

# Optional integration switches default off. Never add real secrets here.
AUTH_GUARDS_VERIFIED=
BACKUPS_VERIFIED=
BANNER_IP_SALT=
CAPTCHA_ENABLED=
EMAIL_DELIVERY_ENABLED=
EMAIL_DOMAIN_VERIFIED=
JOBS_VERIFIED=
NEWSLETTER_IP_SALT=
ONLY_HIGHLIGHTS=
PATRI_LOCAL_SCREENSHOT=
PATRI_PREVIEW_URL=
STRIPE_ENABLED=
STRIPE_VERIFIED=
SUPABASE_ANON_KEY=
SUPABASE_URL=
VITE_CHECKOUT_URL=

VITE_CAPTCHA_ENABLED=false

PORT=5175

# Optional inherited proxy used by local measurement tools; never commit credentials.
HTTPS_PROXY=
https_proxy=

# URL de prévia usada apenas pelos testes editoriais
EDITORIAL_PREVIEW_URL=http://127.0.0.1:5199

# Server-only staging access. Missing/weak password fails closed in preview mode.
PATRI_PREVIEW_MODE=
PREVIEW_ACCESS_PASSWORD=
# Absolute path outside this public repository; never a VITE_ variable.
PATRI_EDITORIAL_REVIEW_FILE=
# Server-only explicit reverse-proxy/local test host allowlist, comma-separated host[:port].
# The configured VITE_SITE_URL host is always included. Forwarded headers are not trusted.
PATRI_ALLOWED_HOSTS=
# Server-only reviewed municipal evidence document (absolute path outside Git).
# Missing document means no local page is approved for indexing; no secret is required.
PATRI_LOCAL_REVIEW_FILE=

# Server-only editorial approval manifest, separate from the protected draft review file.
# Absolute path outside checkout. Missing means no real article is released.
PATRI_EDITORIAL_APPROVAL_FILE=
# Synthetic QA only; accepted only on loopback. Never enable for production.
PATRI_EDITORIAL_FIXTURES=
