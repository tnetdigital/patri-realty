# PRIVATE REAL FILE: staging.runtime.env outside Git. Never fill this example with secrets.
# PREVIEW_ACCESS_PASSWORD must be entered securely, at least 20 characters.
PREVIEW_ACCESS_PASSWORD=
# External staging project only; public key compatible with the current application.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional private manifests; leave blank until the files genuinely exist.
PATRI_LOCAL_REVIEW_FILE=
PATRI_EDITORIAL_APPROVAL_FILE=
PATRI_EDITORIAL_REVIEW_FILE=
# Never add service_role, Stripe/Resend secrets or cron secrets to this SSR container.
