# PREPARED ONLY. Not an enabled vhost. DNS/certificate/log-directory checks pending.
# Install only as a new dedicated vhost after approved diff + syntax + neighbor QA.
server {
    listen 80;
    listen [::]:80;
    server_name previa.patrirealty.com.br;
    access_log off;
    error_log /var/log/patri-realty/nginx-staging.error.log warn;
    return 308 https://previa.patrirealty.com.br$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name previa.patrirealty.com.br;
    ssl_certificate /etc/letsencrypt/live/previa.patrirealty.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/previa.patrirealty.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/patri-realty/nginx-staging.error.log warn;
    client_max_body_size 1m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    location / {
        proxy_pass http://127.0.0.1:15175;
        proxy_http_version 1.1;
        proxy_set_header Host previa.patrirealty.com.br;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_intercept_errors off;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
